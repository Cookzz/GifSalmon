<UserControl
    x:Class="GifSalmon.Shell.Controls.PixelPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 16×16 swatch grid (Phase-2 milestone 1: visual placeholder;
         milestone 4 binds real palette pixels + editor flyout) -->
    <ItemsControl x:Name="Swatches">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid MaximumRowsOrColumns="16" Orientation="Horizontal" ItemWidth="15" ItemHeight="15" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
