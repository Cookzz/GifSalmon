<Application
    x:Class="GifSalmon.Shell.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme-matched palette (app is Dark-only, so plain resources are used;
                  ThemeDictionaries overrides don't reach control templates in WinUI 3) -->
            <SolidColorBrush x:Key="App.Background" Color="#161516" />
            <SolidColorBrush x:Key="App.Panel" Color="#1A1A1A" />
            <SolidColorBrush x:Key="App.Foreground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="App.ForegroundMuted" Color="#AAAAAA" />
            <SolidColorBrush x:Key="App.Rule" Color="#444444" />
            <SolidColorBrush x:Key="App.Btn" Color="#3A393B" />
            <SolidColorBrush x:Key="App.BtnHover" Color="#555555" />
            <SolidColorBrush x:Key="App.BtnPressed" Color="#333333" />
            <SolidColorBrush x:Key="App.Accent" Color="#EE6352" />
            <SolidColorBrush x:Key="App.AccentHover" Color="#F49B90" />
            <SolidColorBrush x:Key="App.AccentPressed" Color="#E4574A" />
            <SolidColorBrush x:Key="App.AccentForeground" Color="#3A393B" />

            <!-- a.btn: #3A393B bg, hover #555, pressed #333, text #eee, no border -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#3A393B" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#555555" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333333" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />

            <!-- sliders: salmon round thumb (#EE6352, hover #F49B90); no salmon value
                 fill — the web sliders are styled without one -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#EE6352" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F49B90" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F49B90" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#3F3F3F" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#3F3F3F" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#3F3F3F" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#2B2B2B" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#333333" />

            <!-- form-group h5: 11px normal #aaa -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{ThemeResource App.ForegroundMuted}" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource App.ForegroundMuted}" />
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>

            <!-- section title with the #444 rule underneath -->
            <Style x:Key="SectionTitleRule" TargetType="Border">
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ThemeResource App.Rule}" />
            </Style>

            <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource App.Btn}" />
                <Setter Property="Foreground" Value="{ThemeResource App.Foreground}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="15,7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- btn-primary: #EE6352 bg, #3A393B text; hover #F49B90 -->
            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
                <Setter Property="Background" Value="{ThemeResource App.Accent}" />
                <Setter Property="Foreground" Value="{ThemeResource App.AccentForeground}" />
            </Style>

            <Style x:Key="AppCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{ThemeResource App.Foreground}" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style x:Key="DimNumberBox" TargetType="NumberBox">
                <Setter Property="MinWidth" Value="52" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
