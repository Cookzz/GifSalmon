<Page
    x:Class="GifSalmon.Shell.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:GifSalmon.Shell.Controls"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource App.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ settings pane ============================ -->
        <ScrollViewer Grid.Column="0" Background="{ThemeResource App.Panel}" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,0" Spacing="4">

                <Border Style="{ThemeResource SectionTitleRule}">
                    <TextBlock Style="{ThemeResource SectionTitle}" Text="Input File" />
                </Border>

                <Button x:Name="SelectFileButton" Style="{StaticResource Btn}" Content="Select File"
                        IsEnabled="{x:Bind State.CanSelectInput, Mode=OneWay}"
                        Visibility="{x:Bind State.IsIdle, Mode=OneWay}" />
                <Button x:Name="ChangeFileButton" Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                        IsEnabled="{x:Bind State.CanSelectInput, Mode=OneWay}"
                        Visibility="{x:Bind State.HasInput, Mode=OneWay}">
                    <!-- css a.input: block, underlined, 13px — wraps like a normal link -->
                    <TextBlock FontSize="13" TextWrapping="Wrap" TextDecorations="Underline"
                               Foreground="{ThemeResource App.Foreground}"
                               Text="{x:Bind State.Settings.InputFileName, Mode=OneWay}" />
                </Button>

                <Border Style="{ThemeResource SectionTitleRule}">
                    <TextBlock Style="{ThemeResource SectionTitle}" Text="Output Options" />
                </Border>

                <!-- Dimensions + Lock Aspect: two fields per row, label above control -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{ThemeResource FieldLabel}" Text="Dimensions" />
                        <StackPanel Orientation="Horizontal" Spacing="4" MinHeight="30" VerticalAlignment="Center">
                            <NumberBox x:Name="WidthBox" Style="{StaticResource DimNumberBox}"
                                       IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                                       Value="{x:Bind State.Settings.Width, Mode=OneWay}" />
                            <TextBlock Foreground="{ThemeResource App.ForegroundMuted}" VerticalAlignment="Center" Text="&#215;" />
                            <NumberBox x:Name="HeightBox" Style="{StaticResource DimNumberBox}"
                                       IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                                       Value="{x:Bind State.Settings.Height, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{ThemeResource FieldLabel}" Text="Lock Aspect" />
                        <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="30" VerticalAlignment="Center">
                            <CheckBox x:Name="LockCheck" Style="{ThemeResource AppCheckBox}" MinWidth="0"
                                      IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                                      IsChecked="{x:Bind State.Settings.Lock, Mode=TwoWay}" />
                            <TextBlock Foreground="{ThemeResource App.Foreground}" FontSize="12" VerticalAlignment="Center"
                                       Text="{x:Bind State.Settings.RatioLabel, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel>
                    <TextBlock Style="{ThemeResource FieldLabel}" Text="FPS" />
                    <NumberBox x:Name="FpsBox" MinWidth="80" HorizontalAlignment="Left"
                               IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                               Value="{x:Bind State.Settings.Fps, Mode=OneWay}" />
                </StackPanel>

                <Border Style="{ThemeResource SectionTitleRule}">
                    <TextBlock Style="{ThemeResource SectionTitle}" Text="Dither Options" />
                </Border>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{ThemeResource FieldLabel}" Text="Dither" />
                        <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="30" VerticalAlignment="Center">
                            <CheckBox x:Name="DitherCheck" Style="{ThemeResource AppCheckBox}" MinWidth="0"
                                      IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                                      IsChecked="{x:Bind State.Settings.Dither, Mode=TwoWay}" />
                            <TextBlock Foreground="{ThemeResource App.Foreground}" FontSize="12" VerticalAlignment="Center"
                                       Text="{x:Bind State.Settings.DitherText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{ThemeResource FieldLabel}" Text="Dither Grid" />
                        <ComboBox x:Name="DitherGridCombo" SelectedIndex="{x:Bind State.Settings.DitherScale, Mode=TwoWay}"
                                  MinWidth="70" HorizontalAlignment="Left"
                                  IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{ThemeResource FieldLabel}" Text="Palette Mode" />
                        <ComboBox x:Name="PaletteModeCombo" FontSize="11" HorizontalAlignment="Left"
                                  SelectedIndex="{x:Bind State.Settings.StatsModeIndex, Mode=TwoWay}"
                                  IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}">
                            <ComboBoxItem Content="Full" />
                            <ComboBoxItem Content="Frame Difference" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{ThemeResource FieldLabel}" Text="Stats Mode" />
                        <ComboBox x:Name="StatsModeCombo" FontSize="11" HorizontalAlignment="Left"
                                  SelectedIndex="{x:Bind State.Settings.DiffModeIndex, Mode=TwoWay}"
                                  IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}">
                            <ComboBoxItem Content="Rectangle" />
                            <ComboBoxItem Content="None" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Style="{ThemeResource SectionTitleRule}">
                    <TextBlock Style="{ThemeResource SectionTitle}" Text="Color Palette" />
                </Border>

                <StackPanel>
                    <TextBlock Style="{ThemeResource FieldLabel}" Text="Colors" />
                    <Grid ColumnSpacing="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="ColorsBox" Grid.Column="0" MinWidth="70"
                                   IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                                   Minimum="16" Maximum="256"
                                   Value="{x:Bind State.ColorValue, Mode=OneWay}" />
                        <Slider x:Name="ColorsSlider" Grid.Column="1" Minimum="16" Maximum="256" StepFrequency="2"
                                IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                                Value="{x:Bind State.ColorValue, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <controls:PixelPalette x:Name="PaletteControl" Margin="0,4,0,20"
                                       Visibility="{x:Bind State.ShowPaletteArea, Mode=OneWay}" />

            </StackPanel>
        </ScrollViewer>

        <!-- ============================ preview pane ============================ -->
        <Grid x:Name="PreviewPane" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{ThemeResource App.Panel}" Padding="20" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ColumnSpacing="10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{ThemeResource App.Foreground}" FontSize="12" MinWidth="34"
                               VerticalAlignment="Center" Text="{x:Bind State.FramesCurrentLabel, Mode=OneWay}" />
                    <Slider x:Name="ScrubSlider" Grid.Column="1" Minimum="0" StepFrequency="0.1"
                            Maximum="{x:Bind State.FramesMax, Mode=OneWay}"
                            IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}"
                            Value="{x:Bind State.FramesCurrent, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Foreground="{ThemeResource App.Foreground}" FontSize="12" MinWidth="34"
                               VerticalAlignment="Center" Text="{x:Bind State.FramesMaxLabel, Mode=OneWay}" />
                </Grid>
                <Button x:Name="ExportButton" Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="Export" VerticalAlignment="Center"
                        IsEnabled="{x:Bind State.ControlsEnabled, Mode=OneWay}" />
            </Grid>

            <!-- state 1/2/3: loader -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                        Visibility="{x:Bind State.ShowLoader, Mode=OneWay}">
                <ProgressRing Width="64" Height="64" IsActive="True" />
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{ThemeResource App.Foreground}"
                           Text="{x:Bind State.LoaderTitle, Mode=OneWay}" HorizontalAlignment="Center" />
                <TextBlock Foreground="{ThemeResource App.ForegroundMuted}" TextAlignment="Center"
                           Text="This could take a while for longer gifs..." />
                <Button x:Name="CancelPaletteButton" Style="{StaticResource Btn}" Content="Cancel" HorizontalAlignment="Center"
                        Visibility="{x:Bind State.IsGeneratingPalette, Mode=OneWay}" />
            </StackPanel>

            <!-- state 4: export progress (css: .progress 20px/50vw, .progress-info flex row) -->
            <Grid x:Name="ExportPanelHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{x:Bind State.ShowExport, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <ProgressBar Height="20" CornerRadius="0" BorderThickness="0"
                                 Value="{x:Bind State.ExportProgress, Mode=OneWay}"
                                 Foreground="{x:Bind State.ExportBarBrush, Mode=OneWay}"
                                 Background="#101010" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                                       Text="{x:Bind State.ExportPercentLabel, Mode=OneWay}" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource App.ForegroundMuted}" Margin="0,0,0,1"
                                       VerticalAlignment="Bottom" Text="{x:Bind State.ExportSizeLabel, Mode=OneWay}" />
                        </StackPanel>
                        <Button x:Name="CancelExportButton" Grid.Column="1" Style="{StaticResource Btn}" Content="Cancel" HorizontalAlignment="Right"
                                Visibility="{x:Bind State.IsExportRunning, Mode=OneWay}" />
                    </Grid>
                    <StackPanel x:Name="ExportDonePanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                Visibility="{x:Bind State.IsExportComplete, Mode=OneWay}">
                        <Button x:Name="ShowInFolderButton" Style="{StaticResource Btn}" Content="Show in folder" />
                        <Button x:Name="PreviewExportButton" Style="{StaticResource Btn}" Content="Preview" />
                        <Button x:Name="DoneButton" Style="{StaticResource BtnPrimary}" Content="Done" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- state 5: preview -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{x:Bind State.ShowPreviewImage, Mode=OneWay}">
                <Image x:Name="PreviewImage" MaxWidth="640" MaxHeight="480" Source="{x:Bind State.ThumbnailImage, Mode=OneWay}" />
            </StackPanel>

        </Grid>
    </Grid>
</Page>
